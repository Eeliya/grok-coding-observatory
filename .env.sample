# Initial project to watch (optional; the repo can be picked in the browser, and the
# last used one is remembered). A CLI argument (`npm start -- /path`) wins over this.
TARGET_DIR=
# HTTP/WebSocket port
PORT=4477
# Interface to bind (127.0.0.1 is reachable from Windows via WSL localhost forwarding)
HOST=127.0.0.1
# Folder scanned (two levels deep) for git repos shown in the picker
REPOS_ROOT=~/work
# Where recent / last-used repos are stored
OBSERVATORY_CONFIG_DIR=~/.config/grok-coding-observatory
# File watching: 1 = poll (needed for repos on /mnt/c/... in WSL, which is the default there),
# 0 = native events everywhere. Leave empty for automatic.
WATCH_POLL=
# Remote access (e.g. through a Cloudflare Tunnel): require a token for every request.
# Set the token itself, or a file holding it (chmod 600). At least 16 characters.
OBSERVATORY_TOKEN=
OBSERVATORY_TOKEN_FILE=
# Public origin(s) of the tunnel, comma-separated, whose pages may post chat messages
OBSERVATORY_PUBLIC_ORIGIN=
